# Ayumi Environment Variables
# Copy this to .env and fill in values
# NEVER commit the actual .env file

# Paperclip
PAPERCLIP_API_KEY=
PAPERCLIP_BASE_URL=http://localhost:3101

# Trading
FTMO_CREDENTIALS=
BROKER_API_KEY=
BROKER_API_SECRET=

# Crypto
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# cTrader FIX API
CTRADER_HOST=
CTRADER_SSL_PORT=
CTRADER_PLAIN_PORT=
CTRADER_ACCOUNT=
CTRADER_PASSWORD=
CTRADER_SENDER_COMP_ID=
CTRADER_TARGET_COMP_ID=
CTRADER_SENDER_SUB_ID=
CTRADER_QUOTE_SENDER_SUB_ID=

# Notifications
# Optional: Discord webhook for trade-opened notifications (card 21bf4320).
# Leave empty to disable the notifier entirely. Do not commit the real value;
# copy from /root/.openclaw/workspace/.env or set it in your local .env.
DISCORD_WEBHOOK=
